---
import MainLayout from "../layouts/MainLayout.astro"
import Pricing from "../sections/Pricing.astro"
import Modules from "../sections/Modules.astro"
import { Image } from 'astro:assets';
import cms from "../images/cms.png"
---

<MainLayout>
	
	<Pricing/>
	
	<div class="bg-transparent">
		<div class="mx-auto max-w-7xl py-16 sm:px-20 sm:py-20 lg:px-24">
			<div class="relative isolate overflow-hidden bg-transparent px-6 pt-16 shadow-2xl sm:rounded-3xl sm:px-16 md:pt-24 lg:flex lg:gap-x-20 lg:px-24 lg:pt-0 border dark:border-gray-600">
				<svg viewBox="0 0 1024 1024" class="absolute left-1/2 top-1/2 -z-10 size-[64rem] -translate-y-1/2 [mask-image:radial-gradient(closest-side,white,transparent)] sm:left-full sm:-ml-80 lg:left-1/2 lg:ml-0 lg:-translate-x-1/2 lg:translate-y-0" aria-hidden="true">
					<circle cx="512" cy="512" r="512" fill="url(#759c1415-0410-454c-8f7c-9a820de03641)" fill-opacity="0.7" />
					<defs>
						<radialGradient id="759c1415-0410-454c-8f7c-9a820de03641"><stop stop-color="#7775D6" /><stop offset="1" stop-color="#E935C1" /></radialGradient>
					</defs>
				</svg>
				<div class="mx-auto max-w-md text-center lg:mx-0 lg:flex-auto lg:py-32 lg:text-left">
					<h2 class="text-balance text-3xl sm:text-4xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">Boost your productivity. Start using our CMS today.</h2>
				<p class="mt-6 text-pretty text-lg/8 text-gray-600 dark:text-gray-400">A simple and elegant management solution for schools and organisers. Say goodbye to long and confusing spreedsheets</p>
				<div class="mt-10 flex items-center justify-center gap-x-6 lg:justify-start">
					<a href="#pricing" class="rounded-md bg-red-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Get started</a>
					<a href="https://corazon.dance/en/solutions-for-schools" target="_blank" class="text-sm/6 font-semibold text-red-500 hover:text-red-700">Learn more <span aria-hidden="true">→</span></a>
				</div>
				</div>
				<div class="relative mt-16 h-80 lg:mt-8">
					<Image src={cms} alt="Corazon Management System" class="absolute left-0 top-0 w-[57rem] max-w-none rounded-md bg-white/5 ring-1 ring-white/10" width="1824" height="1080"/>
				</div>
			</div>
		</div>
	</div>

	<div id="modules">
		<Modules/>
	</div>
</MainLayout>